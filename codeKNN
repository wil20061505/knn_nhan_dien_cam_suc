# ======================================================
# 2. TỪ ĐIỂN VIẾT TẮT / TEENCODE
# ======================================================
# Dùng để chuẩn hoá các từ viết tắt, teencode về từ gốc
# trước khi xử lý phủ định và tách n-gram.
ABBREV_DICT = {
    "ko": "không", "k": "không", "kh": "không",
    "đéo": "không", "đếch": "không", "méo": "không",
    "đc": "được", "dc": "được",
    "cl": "tệ", "vl": "rất", "vcl": "rất",
    "qq": "tệ", "vcc": "vãi",
    "dm": "địt mẹ", "dmm": "địt mẹ",
    "dcm": "địt mẹ mày", "sv": "súc vật",
    "svat": "súc vật",
    "vid": "video", "ch": "chưa", "bt": "biết",
    "cx": "cũng", "ms": "mới", "mik": "mình",
    "mk": "mình", "bn": "bạn", "qa": "quá",
    "j": "gì", "ntn": "như thế nào", "ad": "admin",
    "z": "vậy", "vs": "với", "h": "giờ", "t": "tôi",
    "r": "rồi", "ae": "anh em", "mn": "mọi người",
    "éo": "không"
}


def expand_abbreviations(text):
    """Thay thế từng từ viết tắt/teencode bằng từ đầy đủ.
    Áp dụng match theo từng token (word-level) để tránh thay
    nhầm bên trong các từ dài hơn."""
    words = text.split()
    result = []
    for w in words:
        if w in ABBREV_DICT:
            # một số giá trị thay thế có nhiều từ (vd: "địt mẹ")
            result.extend(ABBREV_DICT[w].split())
        else:
            result.append(w)
    return " ".join(result)


# ======================================================
# 3. CLEAN TEXT
# ======================================================
# BUG FIX: "dở " và "tệ " có khoảng trắng thừa ở cuối nên sau khi
# text.split() không bao giờ khớp được với từ đơn -> đã bỏ khoảng trắng.
NEGATIVE_WORDS = [
    "địt", "ngu", "đần", "lồn", "cặc", "óc", "chó"
]

# BUG FIX: "hài lòng" là cụm 2 từ nhưng so sánh cũ dùng
# `words[i+1] in sentiment_words` (so sánh với 1 từ) nên không bao giờ
# match được. Hàm handle_negation bên dưới đã hỗ trợ cụm nhiều từ.
SENTIMENT_WORDS = [
    "tốt", "hay", "ngon", "đẹp", "thích", "ổn", "chất lượng",
    "hài lòng", "tuyệt vời", "xuất sắc", "ưng ý"
]
# Sắp xếp theo số từ giảm dần để ưu tiên khớp cụm dài trước (longest match)
SENTIMENT_WORDS_SORTED = sorted(
    SENTIMENT_WORDS,
    key=lambda s: len(s.split()),
    reverse=True
)


def handle_negation(text):
    words = text.split()
    result = []
    i = 0
    n = len(words)
    while i < n:
        if words[i] in NEGATIVE_WORDS:
            matched = False
            # thử khớp cụm dài nhất trước (longest match first)
            for phrase in SENTIMENT_WORDS_SORTED:
                phrase_words = phrase.split()
                plen = len(phrase_words)
                if (
                    i + plen < n + 1
                    and words[i + 1:i + 1 + plen] == phrase_words
                ):
                    result.append(
                        words[i] + "_" + "_".join(phrase_words)
                    )
                    i += 1 + plen
                    matched = True
                    break
            if not matched:
                result.append(words[i])
                i += 1
        else:
            result.append(words[i])
            i += 1
    return " ".join(result)


def clean_text(text):
    text = str(text)
    # lowercase
    text = text.lower()
    # emoji
    emoji_map = {
        "😀": "emoji_vui",
        "😂": "emoji_cuoi",
        "😍": "emoji_yeu_thich",
        "❤️": "emoji_tim",
        "😡": "emoji_tuc_gian",
        "😭": "emoji_buon",
        "👍": "emoji_thich",
        "👎": "emoji_khong_thich"
    }
    for e, replace in emoji_map.items():
        text = text.replace(
            e,
            " " + replace + " "
        )
    # URL
    text = re.sub(
        r"https?://\S+",
        " ",
        text
    )
    # giữ tiếng Việt
    text = re.sub(
        r"[^a-zA-ZÀ-ỹ0-9_\s]",
        " ",
        text
    )
    # khoảng trắng
    text = re.sub(
        r"\s+",
        " ",
        text
    )
    text = text.strip()
    # NEW: chuẩn hoá viết tắt / teencode trước khi xử lý phủ định
    text = expand_abbreviations(text)
    # xử lý phủ định
    text = handle_negation(text)
    return text


df["text"] = df["text"].apply(
    clean_text
)
# loại bỏ các dòng rỗng sau khi clean (BUG FIX: tránh chia cho 0 ở TF-IDF)
